# =============================================
# SENA Sistema de Gestión de Asistencia - .env.example
# =============================================
# Copie este archivo como .env y complete con sus valores reales de Neon.
# NUNCA ponga credenciales reales aquí.
# =============================================

DB_HOST=ep-XXXXXXXX.c-X.us-east-X.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=tu_password_neon_aqui

DATABASE_URL=postgresql://neondb_owner:tu_password@ep-XXXXXXXX.c-X.us-east-X.aws.neon.tech/neondb?sslmode=require

# Use una clave larga, aleatoria y distinta por entorno (local/producción).
JWT_SECRET=reemplazar_por_una_clave_larga_y_aleatoria

# Cloudinary: necesario para las imágenes faciales privadas.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# La bandeja interna funciona sin este bloque. Para correo real configure
# un proveedor y un remitente verificado en Vercel.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Asistencia SENA <no-reply@tu-dominio-verificado.com>

# APP_DEBUG=true
